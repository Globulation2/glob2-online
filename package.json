{
  "name": "glob2-online-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/check-i18n.mjs && astro check",
    "build": "astro build && node scripts/stage-guide-media.mjs && pagefind --site dist && node scripts/check-i18n.mjs --built",
    "preview": "astro preview",
    "test": "playwright test",
    "check:media": "node --test scripts/test_guide_media.mjs scripts/test_article_directives.mjs",
    "design:sync": "node scripts/design-system.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/sitemap": "3.7.4",
    "@glob2/design-system": "git+https://github.com/Globulation2/glob2-design-system.git#220b965b061e402df7531fa0f9ad5104bf29a638",
    "astro": "7.3.5",
    "photoswipe": "5.4.4",
    "remark-directive": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "firebase-tools": "15.32.1",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
