---
import '../styles/home.css';
import {site} from '../data/site';
import { localizedMarketing, translate, localizedPath, englishLabel, type Locale } from '../i18n';
const {concept='colony',locale='en'}=Astro.props as {concept?:string;locale?:Locale};
const {home,community}=localizedMarketing(locale);
const t=(key:Parameters<typeof translate>[1], params:Record<string,string|number>={})=>translate(locale,key,params);
const english=(label:string)=>englishLabel(locale,label);
const sprites=['worker','inn','war-flag'];
const shots=[
  {src:'/images/home-thriving-colony.webp',width:1280,height:720,title:t('home.shot.0.title'),caption:t('home.shot.0.caption'),alt:t('home.shot.0.alt')},
  {src:'/images/home-colony-defence.webp',width:1280,height:720,title:t('home.shot.1.title'),caption:t('home.shot.1.caption'),alt:t('home.shot.1.alt')},
  {src:'/images/home-rival-expansion.webp',width:1280,height:720,title:t('home.shot.2.title'),caption:t('home.shot.2.caption'),alt:t('home.shot.2.alt')},
];
const facts=[t('home.fact.0'),t('home.fact.1'),t('home.fact.2')];
---
<div class:list={['home',{'colony':concept==='colony'}]}>
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-colony" aria-hidden="true">
    <video class="colony-video" data-src="/brand/colony-loop.mp4" poster="/brand/colony-1600.webp" muted loop playsinline preload="none" tabindex="-1"></video>
  </div>
  <button class="colony-motion" type="button" data-pause={t('home.pause')} data-resume={t('home.resume')} hidden>❚❚ {t('home.pause')}</button>
  <div class="hero-copy">
    <p class="hero-logo"><span class="wordmark" role="img" aria-label={home.eyebrow}></span><span class="hero-online" aria-hidden="true">{t('ui.online')}</span></p>
    <h1 id="hero-title">{home.title}</h1>
    <p class="hero-description">{home.description}</p>
    <div class="actions">
      <a class="btn primary big" href={site.appUrl}>{home.playLabel} <span aria-hidden="true">↗</span></a>
      <a class="btn big secondary" href={localizedPath(locale,'downloads')}>{t('ui.download')}</a>
      <a class="btn big ghost" href={home.firstSession.href}>{english(t('home.learn'))}</a>
    </div>
    <p class="hero-note">{home.playNote}</p>
  </div>
</section>
<ul class="facts" aria-label={t('home.glance')}>{facts.map(fact=><li>{fact}</li>)}</ul>
<section class="showcase" aria-labelledby="gameplay-title">
  <div class="showcase-head">
    <h2 id="gameplay-title">{home.gameplayTitle}</h2>
    <p>{home.gameplayDescription}</p>
  </div>
  <div class="shots">{shots.map((shot,i)=><figure class:list={['game-window',{"lead-shot":i===0}]}>
    <a href={shot.src} aria-label={t('home.fullImage',{title:shot.title})}><img src={shot.src} width={shot.width} height={shot.height} alt={shot.alt} loading="lazy"/></a>
    <figcaption><strong>{shot.title}.</strong> {shot.caption}</figcaption>
  </figure>)}</div>
  <p class="shots-note">{t('home.shotsNote')}</p>
  <h3 class="decisions-title">{home.decisionsTitle}</h3>
  <ol class="decisions">{home.decisions.map((decision,i)=><li><img src={`/brand/${sprites[i]}.webp`} alt="" width="72" height="72" loading="lazy"/><h4>{decision.title}</h4><p>{decision.description}</p></li>)}</ol>
</section>
<section class="paths" aria-label={t('home.paths')}>
  <article class="path path-lead"><h2>{home.firstSession.title}</h2><p>{home.firstSession.description}</p><a class="btn primary" href={home.firstSession.href}>{english(home.firstSession.label)} <span aria-hidden="true">→</span></a></article>
  {home.playOptions.map(option=><article class="path"><h2>{option.title}</h2><p>{option.description}</p><a class="text-link" href={option.href==='/game/'?localizedPath(locale,'game'):option.href}>{option.label} →</a></article>)}
  <article class="path"><h2>{t('home.discordTitle')}</h2><p>{community.discordDescription}</p><a class="text-link" href={site.discordUrl}>{t('home.discordLink')} ↗</a></article>
</section>
<section class="history" aria-labelledby="history-title"><h2 id="history-title">{home.background.title}</h2><p>{home.background.description}</p><a class="text-link" href={home.background.href}>{english(home.background.label)} →</a></section>
<section class="closing" aria-labelledby="closing-title"><h2 id="closing-title">{home.closing.title}</h2><p>{home.closing.description}</p><div class="actions"><a class="btn primary big" href={site.appUrl}>{home.closing.label} <span aria-hidden="true">↗</span></a><a class="btn secondary big" href={localizedPath(locale,'downloads')}>{t('footer.download')}</a></div></section>
</div>

<script>
import { mountColony } from '@glob2/design-system/colony';
document.querySelectorAll<HTMLVideoElement>('.colony-video').forEach(video => {
 const hero = video.closest<HTMLElement>('.hero')!;
 const button = hero.querySelector<HTMLButtonElement>('.colony-motion')!;
 mountColony(video, button, {pause:`❚❚ ${button.dataset.pause}`,resume:`▶ ${button.dataset.resume}`,container:hero,onPlaying:playing => video.classList.toggle('playing',playing)});
});
</script>
